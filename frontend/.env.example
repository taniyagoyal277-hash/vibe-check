# =====================================================================
# VibeCheck Frontend – Environment Variables
# =====================================================================
# On Vercel, add each variable in:
#   Dashboard → Your Project → Settings → Environment Variables
# =====================================================================

# Your deployed Render backend URL (no trailing slash, no /api)
# Example: https://vibecheck-backend.onrender.com
VITE_API_URL=https://your-backend.onrender.com/api
