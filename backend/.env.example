# =====================================================================
# VibeCheck Backend – Environment Variables
# =====================================================================
# DO NOT commit the real .env file to Git.
# On Render, add each variable below in:
#   Dashboard → Your Service → Environment → Environment Variables
# =====================================================================

# --- Server ---
PORT=5000
NODE_ENV=production

# --- MongoDB (required in production) ---
# Get this from MongoDB Atlas → Clusters → Connect → Drivers
# Replace <user>, <password>, <cluster>, and make sure the DB name is "vibecheck"
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vibecheck?retryWrites=true&w=majority

# --- JWT Authentication ---
# Use a long random string (32+ characters). Never share this.
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Your deployed Vercel frontend URL (no trailing slash).
# If you have multiple, separate with a comma: https://a.vercel.app,https://custom.com
CORS_ORIGIN=https://your-app.vercel.app
